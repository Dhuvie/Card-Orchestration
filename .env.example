# .env.example
# MongoDB Configuration (Local instance is provided via docker-compose)
MONGODB_URL=mongodb://localhost:27017

# Gemini API Key for Vision and Audio Processing
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Sheets Integration
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Provide the Service Account JSON string inline (minify the JSON to one line)
GOOGLE_SHEETS_CREDENTIALS={"type": "service_account", "project_id": "..."}

# WhatsApp Business API Integration
WHATSAPP_TOKEN=your_whatsapp_bearer_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_MANAGER_PHONE=+1234567890
